{
  "manifest_version": 3,
  "name": "CCagent 智囊团侧边栏",
  "version": "1.0.0",
  "description": "逛 X (Twitter) 一键抓推文，内置查理·芒格 10 大思维模型与全自动智能路由，侧边栏直出智囊团深度分析，支持 Grok / Gemini / DeepSeek BYOK。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://ccagent.mycici.top/*"
  ],
  "action": {
    "default_title": "打开 CCagent 智囊团侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "send-selection-to-ccagent": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "将当前选中文字发送到 CCagent 侧边栏"
    }
  }
}
